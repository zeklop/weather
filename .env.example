# Build-time base path — single source for kit.paths.base (static deployment).
# Both forms are valid, no trailing slash:
#   PUBLIC_BASE_PATH=           → root mode (custom domain, repo root)
#   PUBLIC_BASE_PATH=/weather   → GitHub Pages subpath deployment
# Loaded from .env files or shell env (shell env takes precedence).
PUBLIC_BASE_PATH=/weather

# Optional serverless backend (Cloudflare Workers + D1). Omit both for zero-backend mode.
# Worker URL after `wrangler deploy`, e.g. https://weather-pwa-push.<account>.workers.dev
PUBLIC_PUSH_WORKER_URL=
# Public VAPID key from wrangler.toml (base64url)
PUBLIC_VAPID_KEY=
