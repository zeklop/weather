{
	"name": "weather",
	"description": "PWA погоды с кэшированием, без сервера и API-ключей на SvelteKit 5 и Open-Meteo",
	"version": "0.1.0",
	"license": "MIT",
	"author": "zeandre",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"icons": "node scripts/generate-icons.mjs",
		"check:icons": "node scripts/check-icons.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"sharp": "^0.35.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"maplibre-gl": "^6.4.1"
	}
}
